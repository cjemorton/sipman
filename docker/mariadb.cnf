# ============================================================
# SipMan — MariaDB Server Configuration
# Optimized for resource-constrained containers (764MB host)
# ============================================================

[mysqld]
# Bind to loopback only — Kamailio and the Flask API are in-process
bind-address = 127.0.0.1

# Memory: drastically reduced from defaults (128MB → 32MB)
innodb_buffer_pool_size = 32M
innodb_log_buffer_size = 4M
key_buffer_size = 8M
max_connections = 20
table_open_cache = 64

# Performance: skip unnecessary features for a small Kamailio DB
performance_schema = OFF
slow_query_log = OFF
