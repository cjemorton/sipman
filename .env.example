# ============================================================
# SipMan Backend — Environment Configuration
# Copy this file to .env and customize for your deployment.
# ============================================================

# ---- Cluster Identity ----
# Unique ID for this endpoint (must be unique across all peers)
CLUSTER_ID=primary
CLUSTER_NAME=Primary SIP Cluster

# ---- SIP Configuration ----
# The SIP domain this endpoint serves (e.g. sip.example.com)
SIP_DOMAIN=sip.mrnet.work
# The public/external IP address that SIP clients connect to
SIP_EXTERNAL_IP=40.233.87.224
# SIP ports (usually leave defaults)
SIP_PORT=5060
SIPS_PORT=5061

# ---- Database (internal MariaDB) ----
# These configure the internal MariaDB instance.
MARIADB_DB=kamailio
MARIADB_USER=kamailio
MARIADB_PASS=cNN6bVkmbKaSlGiuxNt2EEP0GYCv6DfqfvOp5sNXjrvYI7ub4WDEm1qL9gBUITcA
# Optional: set a root password for MariaDB (leave blank for no root password)
MARIADB_ROOT_PASS=

# ---- RTPEngine ----
RTPENGINE_HOST=127.0.0.1
RTPENGINE_PORT=7722
# Interface RTPEngine binds to (0.0.0.0 = all)
RTPENGINE_INTERFACE=0.0.0.0

# ---- Admin Credentials ----
# Default admin user created on first start
SIPMAN_ADMIN_USER=admin
SIPMAN_ADMIN_PASS=ChangeMeNow!2026#sipman

# ---- JWT Secret ----
# Secret used to sign JWT tokens. Must match the Cloudflare Worker's JWT_SECRET.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SIPMAN_JWT_SECRET=

# ---- Peer Sync (Multi-Cluster) ----
# Comma-separated list of peer backend URLs (internal, not public).
# e.g. PEER_NODES=http://10.0.0.2:5000,http://10.0.0.3:5000
PEER_NODES=
# Shared secret for peer authentication (must be identical on all peers)
PEER_SYNC_SECRET=
# Auto-enabled when PEER_NODES is set
PEER_SYNC_ENABLED=false

# ---- Flask ----
FLASK_SECRET_KEY=

# ---- CORS ----
CORS_ORIGINS=*

# ---- Backend URL (how the Worker reaches this node) ----
# Set this to the public URL of this container's API
CLUSTER_BACKEND_URL=http://sip.mrnet.work:5000
